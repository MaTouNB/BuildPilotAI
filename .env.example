# Copy to .env and generate a local password using scripts/setup_env.py.
# Never commit .env. M00 does not use an LLM or API key.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=buildpilot
POSTGRES_USER=buildpilot
POSTGRES_PASSWORD=

# Legacy M04 setting; M05 never enables unauthenticated build access.
DEMO_ENABLED=false

# Local HTTP only. Keep true for HTTPS deployments.
AUTH_COOKIE_SECURE=false

# M06 approved mock-only mode; no external endpoint or API key is used.
AGENT_PROVIDER=mock
